# AI Provider: "auto" (default), "ollama", "lmstudio", or "anthropic" (paid)
AI_PROVIDER=auto

# Anthropic API (paid) - get key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# LM Studio (free/local) - download from https://lmstudio.ai, load a model, enable local server
LMSTUDIO_URL=http://localhost:1234
LMSTUDIO_MODEL=

# Ollama (free/local) - install from https://ollama.com, then: ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# RentCast property data API (optional) - https://app.rentcast.io/app/api
# Without a key the app falls back to Redfin scraping and state-average rates.
# Free Developer tier is 50 requests/month, then a per-request overage fee, so
# the app asks before spending past the reserve rather than billing silently.
RENTCAST_API_KEY=
RENTCAST_MONTHLY_LIMIT=50
# Optional absolute stop; unset means no hard cap beyond the prompt above.
RENTCAST_HARD_LIMIT=
